{
  "$defs": {
    "EventType": {
      "description": "The gateway's own event names, independent of any provider's.",
      "enum": [
        "code.pushed",
        "pull_request.merged",
        "order.created",
        "order.paid",
        "payment.succeeded",
        "payment.failed",
        "payment.refunded",
        "unhandled"
      ],
      "title": "EventType",
      "type": "string"
    },
    "JsonValue": {},
    "Provider": {
      "enum": [
        "github",
        "shopify",
        "stripe"
      ],
      "title": "Provider",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A verified, normalised webhook event, as ingest queues it for the processor.",
  "properties": {
    "correlation_id": {
      "description": "The API Gateway request ID.",
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "The normalised fields for this event.",
      "title": "Data",
      "type": "object"
    },
    "event_id": {
      "description": "Generated by the gateway at ingest.",
      "format": "uuid4",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "idempotency_key": {
      "description": "'<provider>:<provider_event_id>'.",
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "occurred_at": {
      "description": "When it happened, from the payload.",
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "provider_event_id": {
      "description": "The provider's own ID for the event.",
      "minLength": 1,
      "title": "Provider Event Id",
      "type": "string"
    },
    "received_at": {
      "description": "When ingest accepted the request.",
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "description": "Bumped on breaking changes.",
      "title": "Schema Version",
      "type": "integer"
    },
    "subject_id": {
      "description": "What the event is about: '<provider>:<id>'.",
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "idempotency_key",
    "provider",
    "provider_event_id",
    "event_type",
    "subject_id",
    "occurred_at",
    "received_at",
    "correlation_id",
    "data"
  ],
  "title": "Envelope",
  "type": "object"
}
