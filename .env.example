# Every environment variable the functions read, with an example value.
# The SAM template sets the real values for each stage, and nothing reads a .env
# file. tests/common/test_settings.py checks this file against the Settings model.
# Example account IDs are always 000000000000, never a real one.

# Deployment stage: lowercase, and the last part of PARAMETER_PATH.
STAGE=dev
# SSM Parameter Store path holding one SecureString signing secret per provider.
PARAMETER_PATH=/webhook-gateway/dev
# Main queue: ingest sends envelopes to it, and the processor reads from it.
QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/000000000000/webhook-gateway-dev-events
# Dead-letter queue: the processor sends permanent failures here; the replay tool reads it.
DEAD_LETTER_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/000000000000/webhook-gateway-dev-dlq
# DynamoDB table holding event records and subject state.
TABLE_NAME=webhook-gateway-dev
# S3 bucket for the raw archive.
ARCHIVE_BUCKET=webhook-gateway-dev-archive
